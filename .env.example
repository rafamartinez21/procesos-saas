# Copia este archivo a .env y rellena los valores reales. NUNCA subas .env al repositorio.
# (Para cargarlas en local: en PowerShell, $env:ADMIN_EMAIL="..." antes de npm start,
#  o usa "node --env-file=.env index.js".)

# Servidor
PORT=3000

# Base de datos (MongoDB Atlas). Cadena de conexión completa: mongodb+srv://usuario:clave@cluster.../
# Sin ella, los datos se guardan en memoria (solo desarrollo).
DATABASE_URL=

# Administrador inicial (se crea al arrancar si no existe)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# PROVISIONAL hasta el hito 4 (confirmación por correo): "true" deja las cuentas nuevas ya confirmadas
AUTO_CONFIRMAR=

# Se irán añadiendo en hitos posteriores (solo nombres, sin valores):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# EMAIL_API_KEY=
